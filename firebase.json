{
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "README.md", "**/.*", "**/node_modules/**"],
    "headers": [
      { "source": "**/*.@(html|css|js)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "**/*.@(jpg|svg)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] }
    ]
  }
}
